# --- ZATHURA-LIKE NAVIGATION ---

# Zathura uses J/K (or PageDown/PageUp) to scroll full screens/pages
screen_down             J
screen_up               K

# Zathura uses j/k for smooth line-by-line scrolling
move_down               j
move_up                 k

# Zathura uses h/l for horizontal scrolling
move_left               h
move_right              l

# Go to top/bottom of the document
goto_top                gg
goto_bottom             G

# --- SEARCH & INTERFACE ---

# Zathura style search initiation
search                  /

# Zathura uses Tab to toggle the index/Table of Contents
goto_toc                <tab>

# Zoom controls (Zathura uses minus, plus, and '=' to fit)
zoom_out                -
zoom_in                 =
fit_to_page_width       s

# Rotate page (Zathura uses 'r')
rotate_clockwise        r

# --- FILE OPERATIONS ---

# Zathura uses 'o' to open a file browser
open_document           o

# Quit application
quit                    q
